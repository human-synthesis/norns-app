{
  "name": "norns-app",
  "version": "0.0.1",
  "description": "Starter template for Norns apps",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--preserve-symlinks' norns dev",
    "build": "NODE_OPTIONS='--preserve-symlinks' norns build",
    "preview": "norns preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "norns check",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "lint": "norns lint",
    "test": "bun test"
  },
  "devDependencies": {
    "@human-synthesis/norns": "^0.0.20",
    "@human-synthesis/norns-core": "^0.0.11",
    "@human-synthesis/norns-ui": "^0.0.19",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4",
    "vite": "^8.0.12"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@human-synthesis/norns-tron": "^0.0.3",
    "valibot": "^1.4.0"
  }
}
